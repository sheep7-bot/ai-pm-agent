# ================= LLM =================
# 默认走 opencode-go 网关（OpenAI 兼容）。
# 凭证请写入【系统环境变量】，不要写进本文件、更不要提交到仓库：
#   OPENCODE_GO_API_KEY = sk-xxxxxxxx     （Windows: setx OPENCODE_GO_API_KEY "sk-xxx"）
#
# 如需切换到其它 OpenAI 兼容服务，只需覆盖下面三项：
#   LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
#
# 也可在系统环境变量中设置以下任一项来覆盖默认模型：
#   LLM_BASE_URL=https://opencode.ai/inference/go/v1
#   LLM_MODEL=deepseek-v4.1-flash
#
# 例如切到 DeepSeek 官方（需自备 key）：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-flash

# ================= Tool: Tavily 竞品搜索 =================
# 申请地址: https://tavily.com（有免费额度）
# 同样建议写入系统环境变量 TAVILY_API_KEY
# TAVILY_API_KEY=tvly-xxxxxxxx

# ================= Storage =================
APP_DB_PATH=./data/app.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# ================= Server =================
CORS_ORIGINS=*
