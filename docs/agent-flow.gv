digraph agentflow {
  rankdir=TB;
  compound=true;
  graph [fontname="Microsoft YaHei", fontsize=13, bgcolor="#fffdf8", pad=0.35, nodesep=0.38, ranksep=0.55, splines=spline];
  node [fontname="Microsoft YaHei", fontsize=12.5, shape=box, style="rounded,filled",
        fillcolor="#e8f0fe", color="#8ab4f8", penwidth=1.2, margin="0.16,0.09"];
  edge [fontname="Microsoft YaHei", fontsize=10.5, color="#9a8f7d", arrowsize=0.75, penwidth=1.0];

  /* ============ 一、输入与会话初始化 ============ */
  subgraph cluster_1 {
    label="一、输入与会话初始化";
    fontsize=14; fontcolor="#5c5346"; style="rounded,dashed"; color="#c9bda6"; bgcolor="#fbf7ef"; margin=14;
    U1 [label="用户在前端输入产品想法", fillcolor="#e6f4ea", color="#7bc99a"];
    U2 [label="POST /api/chat（SSE 长连接）"];
    U3 [label="带 session_id ?", shape=diamond, fillcolor="#fff3e0", color="#f0a848", margin="0.05,0.03"];
    U4 [label="新建会话\n（sessions 表）"];
    U5 [label="加载会话与历史"];
    U6 [label="该会话已有 PRD ?", shape=diamond, fillcolor="#fff3e0", color="#f0a848", margin="0.05,0.03"];
    U7 [label="mode = create\n（新建）"];
    U8 [label="mode = revise\n（修订）"];
    U9 [label="写入用户消息\n（messages 表）"];
    U1 -> U2;
    U2 -> U3;
    U3 -> U4 [label="否"];
    U3 -> U5 [label="是"];
    U4 -> U6;
    U5 -> U6;
    U6 -> U7 [label="否"];
    U6 -> U8 [label="是"];
    U7 -> U9;
    U8 -> U9;
  }

  /* ============ 二、LangGraph 编排 ============ */
  subgraph cluster_2 {
    label="二、LangGraph Agent 编排（StateGraph 状态机）";
    fontsize=14; fontcolor="#5c5346"; style="rounded,dashed"; color="#c9bda6"; bgcolor="#fbf7ef"; margin=14;
    A0 [label="START", fillcolor="#e6f4ea", color="#7bc99a"];
    A1 [label="analyze：识别意图，发出 step 事件"];
    A2 [label="mode ?", shape=diamond, fillcolor="#fff3e0", color="#f0a848", margin="0.05,0.03"];
    P1 [label="planning：LLM(JSON·关思考)\n输出调研计划并选择工具"];
    R1 [label="revise_prd：LLM(JSON·开思考)\n基于现有 PRD + 指令重写"];
    T1 [label="research：并发执行工具"];
    D1 [label="draft_prd：LLM(JSON·开思考)\n生成结构化 PRD"];
    D2 [label="Pydantic 校验通过 ?", shape=diamond, fillcolor="#fff3e0", color="#f0a848", margin="0.05,0.03"];
    D3 [label="携带错误重试（≤ 3 次）"];
    F1 [label="产出 PRD 结果", fillcolor="#e6f4ea", color="#7bc99a"];
    A0 -> A1;
    A1 -> A2;
    A2 -> P1 [label="create"];
    A2 -> R1 [label="revise"];
    P1 -> T1;
    T1 -> D1;
    D1 -> D2;
    D2 -> D3 [label="否"];
    D3 -> D1 [style=dashed];
    D2 -> F1 [label="是"];
    R1 -> F1;
  }

  /* ============ 三、工具调用 ============ */
  subgraph cluster_3 {
    label="三、工具调用（research 节点内并发执行）";
    fontsize=14; fontcolor="#5c5346"; style="rounded,dashed"; color="#c9bda6"; bgcolor="#fbf7ef"; margin=14;
    W0 [label="构造查询词\nweb_queries / knowledge_queries"];
    W1 [label="启用 Web 搜索 ?", shape=diamond, fillcolor="#fff3e0", color="#f0a848", margin="0.05,0.03"];
    W2 [label="web_search → Tavily API\n竞品 / 市场 / 价格", fillcolor="#e0f2f1", color="#4db6ac"];
    W3 [label="跳过\n（无 Key 时降级）"];
    W4 [label="需要知识库 ?", shape=diamond, fillcolor="#fff3e0", color="#f0a848", margin="0.05,0.03"];
    W5 [label="knowledge_query → 本地 KB\nPRD 方法论 / 优先级模型", fillcolor="#e0f2f1", color="#4db6ac"];
    W6 [label="跳过"];
    W9 [label="汇总为上下文（含来源链接）"];
    W0 -> W1;
    W1 -> W2 [label="是"];
    W1 -> W3 [label="否"];
    W0 -> W4;
    W4 -> W5 [label="是"];
    W4 -> W6 [label="否"];
    W2 -> W9;
    W3 -> W9;
    W5 -> W9;
    W6 -> W9;
  }

  /* ============ 四、记忆与版本化 ============ */
  subgraph cluster_4 {
    label="四、记忆与版本化（双库分离）";
    fontsize=14; fontcolor="#5c5346"; style="rounded,dashed"; color="#c9bda6"; bgcolor="#fbf7ef"; margin=14;
    M1 [label="写短期记忆：checkpointer\nthread_id = session_id，保存整轮 state", fillcolor="#fde8e8", color="#f0a0a0"];
    M2 [label="checkpoints.db", shape=cylinder, fillcolor="#f3e8fd", color="#b98cf0"];
    M3 [label="写长期记忆：PRD 版本\nversion / data / change_summary / changed_sections", fillcolor="#fde8e8", color="#f0a0a0"];
    M4 [label="app.db", shape=cylinder, fillcolor="#f3e8fd", color="#b98cf0"];
    M1 -> M2;
    M3 -> M4;
  }

  /* ============ 五、输出与前端呈现 ============ */
  subgraph cluster_5 {
    label="五、输出与前端呈现（SSE 事件流 · 不暴露思维链）";
    fontsize=14; fontcolor="#5c5346"; style="rounded,dashed"; color="#c9bda6"; bgcolor="#fbf7ef"; margin=14;
    E1 [label="SSE：session → step* → prd → message_delta* → done", fillcolor="#e6f4ea", color="#7bc99a"];
    E2 [label="step：渲染「执行过程」内联时间线"];
    E3 [label="message_delta：流式自然语言回复"];
    E4 [label="prd：内联渲染结构化 PRD\n版本徽标 + 字段级变更高亮"];
    E1 -> E2;
    E1 -> E3;
    E1 -> E4;
  }

  /* ============ 跨区连接 ============ */
  U9 -> A0;
  T1 -> W0;
  W9 -> D1;
  F1 -> M1;
  M1 -> M3;
  M3 -> E1;
}
